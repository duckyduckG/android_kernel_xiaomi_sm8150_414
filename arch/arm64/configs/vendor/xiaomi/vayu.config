# Platform
CONFIG_MACH_XIAOMI_VAYU=y

# Audio
CONFIG_SND_SOC_CS35L41=y
CONFIG_MSM_CSPL=y

# Power
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_ONEWIRE_GPIO=y
CONFIG_BQ2597X_CHARGE_PUMP=y

# SMB
# CONFIG_QPNP_FG_GEN4 is not set
# CONFIG_QPNP_SMB5 is not set
CONFIG_QPNP_FG_GEN4_VAYU=y
CONFIG_QPNP_SMB5_VAYU=y

# Touchscreen
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y

# KSU
CONFIG_KSU=y
CONFIG_KPROBES=n
CONFIG_HAVE_KPROBES=n
CONFIG_KPROBE_EVENTS=n
